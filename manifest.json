{
  "manifest_version": 3,
  "name": "Eye Check",
  "version": "1.0.0",
  "description": "Camera preview that puts a box around each eye and tells you if your eyes are visible.",
  "action": {
    "default_title": "Eye Check",
    "default_popup": "camera.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
